# Runtime
ENV=dev
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Redis
REDIS_URL=redis://localhost:6379/0

# State machine
# NOTE: the confirmation window (D-43) is NOT an environment variable. It is the
# compile-time constant shared.redis_keys.CONFIRM_DELAY_MS (8000 ms), because the
# replay goldens in tests/fixtures/raw_streams/ are only goldens if the window that
# produced them cannot be changed by the shell that runs the replay.
# TEST ONLY - SIGKILLs the state machine after the named stage; must be unset in any
# deployed environment. Stages: nx_claim, kafka_send, state_write, commit.
# services/state_machine/main.py refuses to start with this set unless ENV is EXPLICITLY
# one of dev/test/ci/local. The interlock is an allowlist and fails closed, so unset,
# blank, staging and production are all refused (T-02-04).
MISE_CRASH_AFTER=
# How many times one Kafka message may be retried before the state machine treats it as
# poison: it is published to availability.dlq with the original bytes plus diagnostic
# headers, committed past, and logged as message_retries_exhausted. Default 5, which at the
# 2 s backoff is ~10 s of trying — long enough to ride out a Redis failover, short enough
# that a permanent failure does not hold the partition. Must be >= 1; 0 or a typo is refused
# at startup rather than silently restoring the unbounded retry that stalled the partition
# forever (CR-01).
STATE_MACHINE_MAX_ATTEMPTS=5

# Postgres (docker-compose credentials + both driver URLs)
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise
POSTGRES_DB=mise
DATABASE_URL_ASYNC=postgresql+asyncpg://mise:mise@localhost:5432/mise
DATABASE_URL_SYNC=postgresql+psycopg://mise:mise@localhost:5432/mise

# Twilio (10DLC + toll-free backup)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TOLLFREE_FROM_NUMBER=+18005551234

# Resy (>=3 pre-authenticated accounts — D-24, FOUND-06)
# Two-phase secret handling (see docs/runbooks/resy-cookie-capture.md):
#   Phase 1 (bootstrap): user enters raw email/password below ONLY to log in once in a
#                        supervised browser session and capture the post-login cookies.
#   Phase 2 (runtime):   captured cookies are serialized into RESY_ACCOUNTS_JSON (the
#                        canonical runtime secret — never stores passwords). Playwright
#                        loads cookies from RESY_ACCOUNTS_JSON into browser context
#                        memory only; Pitfall 8 forbids DB persistence.
RESY_ACCOUNT_1_EMAIL=account1@example.com
RESY_ACCOUNT_1_PASSWORD=replace_me
RESY_ACCOUNT_2_EMAIL=account2@example.com
RESY_ACCOUNT_2_PASSWORD=replace_me
RESY_ACCOUNT_3_EMAIL=account3@example.com
RESY_ACCOUNT_3_PASSWORD=replace_me
RESY_ACCOUNTS_JSON=[{"email":"account1@example.com","cookies":{}}]
# RESY_ENABLED=true with NO accounts starts the fleet in a visibly-labelled anonymous mode
# (contexts without cookies, one `resy_anonymous_mode` warning) rather than failing — that
# is what lets the stub-backed tests and the soak script run without secrets. Leaving it
# false means Chromium is NEVER launched: the seed creates no Resy row, enqueues no
# resy:{venue_id} job, and the poller never constructs the Resy adapter (D-63).

# Resy fleet (D-60..D-65, D-69, D-72). Every one of these is read through a FUNCTION in
# services/poller/config.py, never a module constant, so a value cannot be frozen at import.
RESY_ENABLED=false                       # master switch; false = no Resy row, job or browser
RESY_API_BASE=https://api.resy.com       # overridden to http://127.0.0.1:PORT by the stub tests
RESY_API_KEY=                            # human-gated: docs/runbooks/resy-cookie-capture.md
RESY_AUTH_TOKEN_HEADER=X-Resy-Auth-Token # header NAME for the per-account token (research A5)
RESY_PROXY_URL=                          # optional residential proxy; unset = direct
RESY_CONTEXTS=4                          # BrowserContexts in the pool; 1 browser, N contexts
RESY_GLOBAL_RPM=80                       # fleet-wide cap the public README commits to
RESY_BASELINE_INTERVAL_SECONDS=180       # Resy poll cadence, clamped to the 45 s POLL-05 floor
RESY_DATE_RANGE_DAYS=3                   # days x party sizes = requests per poll (3 x 1 = 3)
RESY_PARTY_SIZES=2                       # comma-separated; a typo RAISES, never defaults
POLL_WORKERS=                            # unset = 1 + RESY_CONTEXTS when Resy is on, else 1
METRICS_PORT=9101                        # Prometheus exposition port; Phase 7 scrapes it

# VAPID (Web Push)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@mise.place

# HMAC (admin management endpoints — D-26)
HMAC_MGMT_SECRET_V1=your_32_byte_hex_secret_here

# GCP
GCP_PROJECT_ID=mise-en-place-prod
